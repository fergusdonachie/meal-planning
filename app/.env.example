# GitHub repo the app pulls recipe data and images from at runtime.
# Copy this file to .env (for local dev) and/or set these as Environment
# Variables in the Vercel project settings. Defaults (in src/lib/github.js)
# already point at fergusdonachie/meal-planning@main, so these are only
# needed if you fork or rename the repo.
VITE_GITHUB_OWNER=fergusdonachie
VITE_GITHUB_REPO=meal-planning
VITE_GITHUB_BRANCH=main
