{
  "manifest_version": 3,
  "name": "The Weekly Table — Morrisons companion",
  "version": "0.1.0",
  "description": "Shop your weekly ingredients alongside Morrisons, save preferred products and inspect current page availability.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "sidePanel"],
  "host_permissions": ["https://groceries.morrisons.com/*", "https://fd-meal-planner.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open your weekly Morrisons shopping list" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [{ "matches": ["https://fd-meal-planner.vercel.app/*"], "js": ["bridge.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
